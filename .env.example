# Copy to .env and fill in. Everything is optional.
# Free keys: Groq -> console.groq.com   Gemini -> aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
NCBI_API_KEY=

# groq | gemini | ollama
DEFAULT_PROVIDER=groq
# en | ar  (interface language; switchable in the app)
DEFAULT_LANGUAGE=en

# Ollama running on your own computer, seen from inside Docker:
OLLAMA_URL=http://host.docker.internal:11434

# 1 = shared web server for strangers (nothing saved on the server,
# each visitor's key stays in their own browser session, Groq/Gemini only)
PUBLIC_MODE=0
